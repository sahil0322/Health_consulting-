# Copy to .env and fill in real values. Never commit the populated .env.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://consult:consult@localhost:5432/consult

JWT_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Real AI features ---
# Both are just an API key, no cloud project/billing console needed:
#   Anthropic:  https://console.anthropic.com/settings/keys
#   OpenAI:     https://platform.openai.com/api-keys  (used for Whisper transcription)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

PII_REDACTION_ENABLED=true
